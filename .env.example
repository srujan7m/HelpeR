# Database
DATABASE_URL="postgresql://user:password@localhost:5432/helper_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Calendar API
GOOGLE_CALENDAR_CLIENT_EMAIL="your-service-account-email@project.iam.gserviceaccount.com"
GOOGLE_CALENDAR_PRIVATE_KEY="your-service-account-private-key"
GOOGLE_CALENDAR_ID="primary"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Gemini AI
GEMINI_API_KEY="your-gemini-api-key"

# Resend (Email)
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Application
NODE_ENV="development"
